Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"BernoulliGraphDistribution", "[", 
     RowBox[{"n", ",", "ped"}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"n", " ", "=", " ", 
     RowBox[{"number", " ", "of", " ", "nodes"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"ped", " ", "=", " ", 
     RowBox[{"edges", " ", "probability"}]}], ";"}], "\[IndentingNewLine]", 
   "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "500"}], ";", " ", 
    RowBox[{"ped", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"net", "=", 
     RowBox[{"RandomGraph", "[", 
      RowBox[{
       RowBox[{"BernoulliGraphDistribution", "[", 
        RowBox[{"n", ",", "ped"}], "]"}], ",", 
       RowBox[{"VertexLabels", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxcomp", "=", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "#", "]"}], "&"}], "/@", 
       RowBox[{"ConnectedComponents", "[", "net", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"net", ",", "maxcomp"}], "}"}], ";"}]}]}]], "Input",
