Cell[CellGroupData[{

Cell["Mean over multiple epidemics - no behavior", "Subsubsection",
 CellChangeTimes->{{3.840788806284315*^9, 3.840788813619851*^9}, {
   3.846845080124158*^9, 3.846845081411756*^9}, 
   3.8468451144567966`*^9},ExpressionUUID->"8c759151-0ea1-4298-993c-\
75ec9843b109"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"epis", "=", "200"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"epidist", "=", 
    RowBox[{
    "ParallelTable", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"(*", 
       RowBox[{"Create", " ", "the", " ", "network"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"n", "=", "500"}], ";", " ", 
       RowBox[{"ped", "=", "0.05"}], ";", "\[IndentingNewLine]", 
       RowBox[{"net", "=", 
        RowBox[{"RandomGraph", "[", 
         RowBox[{
          RowBox[{"BernoulliGraphDistribution", "[", 
           RowBox[{"n", ",", "ped"}], "]"}], ",", 
          RowBox[{"VertexLabels", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";"}], 
      "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Define", " ", "iterations", " ", "#"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"it", "=", "100"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Declare", " ", "infected"}], ",", " ", 
         RowBox[{
         "susceptible", " ", "and", " ", "recovered", " ", "vectors"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Clear", "[", 
        RowBox[{"i", ",", "s"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"i0", "=", 
        RowBox[{"RandomInteger", "[", "n", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"i", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"k", "\[Equal]", "i0"}], ",", "1", ",", "0"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"s", "=", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{"1", ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "-", "i"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"r", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"pi", "=", 
        RowBox[{"(*", "0.05", "*)"}], "0.05"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"Infection", " ", 
         RowBox[{"prob", "."}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"pr", "=", "0.04"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"Recovery", " ", 
         RowBox[{"prob", "."}]}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"epi", "=", 
        RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
          "#", " ", "of", " ", "infected", " ", "neighboors", " ", "per", " ",
            "node"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"infn", "=", 
            RowBox[{
             RowBox[{"AdjacencyMatrix", "[", "net", "]"}], ".", "i"}]}], ";", 
           " ", "\[IndentingNewLine]", 
           RowBox[{"ninfp", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"1", "-", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", "pi"}], ")"}], "#"]}], "&"}], "/@", 
             "infn"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Newly", " ", "infected", " ", "nodes"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"x", "=", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"1", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"newinf", "=", 
            RowBox[{"Boole", "[", 
             RowBox[{"Thread", "[", 
              RowBox[{"x", "\[LessEqual]", "ninfp"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"upi", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"s", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}], "&&", 
                 RowBox[{
                  RowBox[{"newinf", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}]}], ",", 
                "1", ",", "0"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Update", " ", "S", " ", "and", " ", "I", " ", 
             RowBox[{"vectors", ":", " ", 
              RowBox[{"after", " ", "infections"}]}]}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"inew", "=", 
            RowBox[{"i", "+", "upi"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"snew", "=", 
            RowBox[{"s", "-", "upi"}]}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"y", "=", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"1", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"newrec", "=", 
            RowBox[{"Boole", "[", 
             RowBox[{"Thread", "[", 
              RowBox[{"y", "\[LessEqual]", "pr"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Update", " ", "I", " ", "and", " ", "R", " ", 
             RowBox[{"vectors", ":", " ", 
              RowBox[{"after", " ", "recovery"}]}]}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"upr", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"inew", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}], "&&", 
                 RowBox[{
                  RowBox[{"newrec", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}]}], ",", 
                "1", ",", "0"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"rnew", "=", 
            RowBox[{"r", "+", "upr"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"inew", "=", 
            RowBox[{"inew", "-", "upr"}]}], ";", "\[IndentingNewLine]", " ", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Update", " ", "variable", " ", "vectors"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"s", "=", "snew"}], ";", " ", 
           RowBox[{"i", "=", "inew"}], ";", 
           RowBox[{"r", "=", "rnew"}], ";", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Count", "[", 
              RowBox[{"snew", ",", "1"}], "]"}], ",", 
             RowBox[{"Count", "[", 
              RowBox[{"inew", ",", "1"}], "]"}], ",", 
             RowBox[{"Count", "[", 
              RowBox[{"rnew", ",", "1"}], "]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"l", ",", "2", ",", "it"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "epi"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "epis"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"epi", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", "2"}], "]"}], "]"}], "/", "n"}], ",", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}]}], "]"}], "*)"}]}]}], "Input",
