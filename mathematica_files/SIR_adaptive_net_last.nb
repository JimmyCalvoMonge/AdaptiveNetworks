Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "function", " ", "returns", " ", "the", " ", "number", " ", 
    "and", " ", "the", " ", "list", " ", "of", " ", "infected", " ", 
    "neighbors", " ", "of", " ", "a", " ", "given", " ", "node"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"infneighs", "[", 
    RowBox[{"ntwk_", ",", "nodeid_", ",", "neighsize_", ",", "ilist_"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ntw", "=", "ntwk"}], ",", 
       RowBox[{"node", "=", "nodeid"}], ",", " ", 
       RowBox[{"ns", "=", "neighsize"}]}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"inf", "=", 
       RowBox[{"Flatten", "@", 
        RowBox[{"Position", "[", 
         RowBox[{"ilist", ",", "1"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"neighlist", "=", 
       RowBox[{
        RowBox[{"IncidenceList", "[", 
         RowBox[{"ntw", ",", "node", ",", "ns"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", "2"}], "]"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Delete", "[", 
         RowBox[{
          RowBox[{"VertexList", "@", 
           RowBox[{"NeighborhoodGraph", "[", 
            RowBox[{"ntw", ",", "node", ",", "ns"}], "]"}]}], ",", "1"}], 
         "]"}], ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"ids", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{"inf", ",", "#"}], "]"}], "&"}], "/@", "neighlist"}]}], 
         ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"pos", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{"ids", ",", "True"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"infneigh", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"neighlist", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "&"}], "/@", " ", "pos"}]}], 
         ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"r", ",", "1", ",", 
          RowBox[{"Length", "[", "neighlist", "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{"node", ",", 
         RowBox[{"Length", "[", "infneigh", "]"}], ",", "infneigh"}], "}"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}]}]], "Input",
