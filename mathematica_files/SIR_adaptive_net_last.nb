            ",", " ", 
            RowBox[{
            "all", " ", "possible", " ", "variable", " ", "states"}]}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"Psi", "=", 
              RowBox[{"1", "-", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", "Pt"}], ")"}], "edgesd"]}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "Evaluating", " ", "the", " ", "expected", " ", "utilities"}], 
              " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
              "Utility", " ", "gained", " ", "by", " ", "being", " ", 
               "currently", " ", "susceptible"}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"EUS", "[", 
               RowBox[{"[", "t", "]"}], "]"}], "=", " ", 
              RowBox[{
               RowBox[{"fs", "[", 
