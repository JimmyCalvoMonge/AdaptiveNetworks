                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", "Psi"}], ")"}], " ", 
                   RowBox[{"EUS", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}], "+", 
                  RowBox[{"Psi", " ", 
                   RowBox[{"EUI", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}]}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"EUI", "[", 
               RowBox[{"[", "t", "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{
                RowBox[{"(", "0", ")"}], 
                RowBox[{"fs", "[", 
                 RowBox[{"b", ",", "\[Nu]", ",", "maxed"}], "]"}]}], "+", " ", 
               RowBox[{"\[Delta]", 
                RowBox[{"(", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", "Pir"}], ")"}], " ", 
                   RowBox[{"EUI", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}], "+", 
                  RowBox[{"Pir", " ", 
                   RowBox[{"EUR", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}]}], " ", 
                 ")"}]}]}]}], ";", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"EUR", "[", 
               RowBox[{"[", "t", "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"fs", "[", 
                RowBox[{"b", ",", "\[Nu]", ",", "maxed"}], "]"}], "+", 
               RowBox[{"\[Delta]", " ", 
                RowBox[{"EUR", "[", 
                 RowBox[{"[", 
                  RowBox[{"t", "+", "1"}], "]"}], "]"}]}]}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
               "Compare", " ", "the", " ", "new", " ", "utility", " ", "with",
