Cell[CellGroupData[{

Cell["Mean over multiple epidemics - behavior", "Subsubsection",
 CellChangeTimes->{{3.840623087520255*^9, 3.840623087927779*^9}, {
  3.840796141565896*^9, 3.840796177838524*^9}, {3.846845110362505*^9, 
  3.846845118328759*^9}},ExpressionUUID->"1dbc615d-56da-43a1-ae46-\
0a8d16f92993"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bepis", "=", "200"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Iterations", " ", "of", " ", "epidemics"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ns", "=", "1"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Neighborhood", " ", "size"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bepidist", "=", 
   RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"(*", 
      RowBox[{"Create", " ", "the", " ", "network"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", "500"}], ";", " ", 
      RowBox[{"ped", "=", "0.05"}], ";", "\[IndentingNewLine]", 
      RowBox[{"net", "=", 
       RowBox[{"RandomGraph", "[", 
        RowBox[{
         RowBox[{"BernoulliGraphDistribution", "[", 
          RowBox[{"n", ",", "ped"}], "]"}], ",", 
         RowBox[{"VertexLabels", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";"}], 
     "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Define", " ", "iterations", " ", "#"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"it", "=", "100"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Declare", " ", "infected"}], ",", " ", 
        RowBox[{
        "susceptible", " ", "and", " ", "recovered", " ", "vectors"}]}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Clear", "[", 
       RowBox[{"i", ",", "s"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"i0", "=", 
       RowBox[{"RandomInteger", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"i", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"k", "\[Equal]", "i0"}], ",", "1", ",", "0"}], "]"}], ",", 
         
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"1", ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "-", "i"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"r", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"pi", "=", 
       RowBox[{"(*", "0.05", "*)"}], "0.05"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"Infection", " ", 
        RowBox[{"prob", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"pr", "=", "0.04"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"Recovery", " ", 
        RowBox[{"prob", "."}]}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"T", "=", "7"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"Planning", " ", "horizon"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ns", "=", "1"}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"Neighborhood", " ", "size"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"rednet", "=", "net"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"epib", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
         "#", " ", "of", " ", "infected", " ", "neighboors", " ", "per", " ", 
          "node"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"infn", "=", 
           RowBox[{
            RowBox[{"AdjacencyMatrix", "[", "rednet", "]"}], ".", "i"}]}], 
          ";", " ", "\[IndentingNewLine]", 
          RowBox[{"ninfp", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"1", "-", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", "pi"}], ")"}], "#"]}], "&"}], "/@", 
            "infn"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Newly", " ", "infected", " ", "nodes"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"x", "=", 
           RowBox[{"RandomReal", "[", 
            RowBox[{"1", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"newinf", "=", 
           RowBox[{"Boole", "[", 
            RowBox[{"Thread", "[", 
             RowBox[{"x", "\[LessEqual]", "ninfp"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"upi", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"s", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}], "&&", 
                RowBox[{
                 RowBox[{"newinf", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}]}], ",", 
