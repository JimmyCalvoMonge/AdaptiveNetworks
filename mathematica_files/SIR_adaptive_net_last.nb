Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Single", " ", "peak", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fs", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", " ", "z"}], " ", "-", 
       SuperscriptBox["z", "2"]}], ")"}], "y"]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "The", " ", "maxer", " ", "code", " ", "runs", " ", "the", " ", 
     "optimization", " ", "process", " ", "for", " ", "each", " ", "vertex"}],
     " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vertxmaxer", "[", 
     RowBox[{
     "ntwk_", ",", "nodeid_", ",", "dispars_", ",", "u_", ",", "neis_"}], 
     "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"ntw", "=", "ntwk"}], ",", " ", 
        RowBox[{"(*", " ", 
         RowBox[{"network", " ", "used"}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"node", "=", 
         RowBox[{"nodeid", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
        RowBox[{"maxed", "=", 
         RowBox[{"nodeid", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "the", " ", "node", " ", "for", " ", "which", " ", "the", " ", 
          "maximizer", " ", "is", " ", "running", " ", "and", " ", "the", " ",
           "information", " ", "about", " ", "inf", " ", "neghbours"}], " ", 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"\[Beta]", "=", 
         RowBox[{"dispars", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\[Gamma]", "=", 
         RowBox[{"dispars", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
        RowBox[{"(*", 
         RowBox[{"disease", " ", "parameters"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"T", "=", "u"}], " ", ",", 
        RowBox[{"(*", 
         RowBox[{"time", " ", "horizon"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ns", "=", "neis"}]}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Neighboorhood", " ", "size", " ", "to", " ", "get", " ", "the", " ", 
         "local", " ", "prevalence"}], "*)"}], "\[IndentingNewLine]", "}"}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"maxer", "[", 
         RowBox[{"u_", ",", "v_", ",", "w_"}], "]"}], ":="}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Nu]", "=", "0.05"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"b", "=", 
        RowBox[{"2", "*", "maxed"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "maximum", " ", "possible", " ", "#", " ", "of", " ", "edges", " ", 
          "for", " ", "the", " ", "utility", " ", "function"}], ",", " ", 
         RowBox[{
         "the", " ", "optimal", " ", "utility", " ", "is", " ", "assumed", 
          " ", "at", " ", "half", " ", "of", " ", "this"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"\[Delta]", "=", "0.99986"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"discount", " ", "factor"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Vector", " ", "storing", " ", "the", " ", "optimal", " ", "s", " ", 
         "utility"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"EUS", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "The", " ", "last", " ", "step", " ", "in", " ", "s", " ", "assumes", 
         " ", "to", " ", "use", " ", "all", " ", "edges"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"EUS", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", 
        RowBox[{"fs", "[", 
         RowBox[{"b", ",", "\[Nu]", ",", "maxed"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Vector", " ", "storaging", " ", "the", " ", "optimal", " ", "i", " ",
          "utility"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"EUI", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Vector", " ", "storaging", " ", "the", " ", "optimal", " ", "i", " ",
          "utility"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"EUR", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "The", " ", "last", " ", "step", " ", "in", " ", "r", " ", "assumes", 
         " ", "to", " ", "use", " ", "all", " ", "edges"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"EUR", "[", 
           RowBox[{"[", 
            RowBox[{"-", "1"}], "]"}], "]"}], "=", 
          RowBox[{"fs", "[", 
           RowBox[{"b", ",", "\[Nu]", ",", "maxed"}], "]"}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Vector", " ", "storing", " ", "the", " ", "optimal", " ", "#", " ", 
         "of", " ", "edges", " ", "for", " ", "the", " ", "susceptible", " ", 
         "node", " ", "during", " ", "the", " ", "planning", " ", "horizon"}],
         " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"nedgest", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"nedgest", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", "maxed"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Pt", " ", "is", " ", "the", " ", "probability", " ", "of", " ", 
         "disease", " ", "transmission", " ", "along", " ", "an", " ", "edge",
          " ", "during", " ", "a", " ", "single", " ", "time", " ", "step"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Pt", "=", "\[Beta]"}], ";", " ", 
       RowBox[{"Pir", "=", "\[Gamma]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Optimization", " ", "procedure"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"t", "=", "T"}], ",", 
         RowBox[{"t", "\[GreaterEqual]", " ", "1"}], ",", 
         RowBox[{"t", "--"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"Horizon", " ", "times"}], ",", " ", 
           RowBox[{"this", " ", "goes", " ", "backwards"}]}], " ", "*)"}], 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"individual", "'"}], "s", " ", "utility", " ", "starts", 
           " ", "at", " ", "zero"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"maxu", "=", "0"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
             "Reset", " ", "the", " ", "list", " ", "of", " ", "neighbors"}], 
