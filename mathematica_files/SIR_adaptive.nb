Cell["SIR behavior solver function - fixed # of contacts", "Subsubsection",
 CellChangeTimes->{{3.7603912142563953`*^9, 3.760391226463447*^9}, {
  3.76039131551674*^9, 3.760391318676724*^9}, {3.766001510557158*^9, 
