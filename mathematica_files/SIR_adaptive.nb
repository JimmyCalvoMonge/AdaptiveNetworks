      RowBox[{"ci", "=", 
       RowBox[{"cv", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"cr", "=", 
       RowBox[{"cv", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}]}], "\[IndentingNewLine]", "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"Return", "[", 
     RowBox[{"\[Beta]", " ", "cs", " ", "s", " ", 
      FractionBox[
       RowBox[{"ci", " ", "i"}], 
       RowBox[{
        RowBox[{"cs", " ", "s"}], "+", 
        RowBox[{"ci", " ", "i"}], "+", 
