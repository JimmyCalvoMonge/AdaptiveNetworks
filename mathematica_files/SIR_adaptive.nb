Cell[CellGroupData[{

Cell["Maximizer", "Subsubsection",
 CellChangeTimes->{{3.7603912142563953`*^9, 
  3.760391263449733*^9}},ExpressionUUID->"594d6b42-e476-4bac-9907-\
54db5ee3a3fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Single", " ", "peak", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"fs", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], ":=", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", " ", "z"}], " ", "-", 
       SuperscriptBox["z", "2"]}], ")"}], "y"]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "maxer", " ", "code", " ", "runs", " ", "the", " ", 
     "optimization", " ", "process"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Maxer", "[", 
     RowBox[{"pops_", ",", "dispars_", ",", "plan_", ",", "disen_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"s", "=", 
         RowBox[{"pops", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"i", "=", 
         RowBox[{"pops", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"r", "=", 
         RowBox[{"pops", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], ",", 
        RowBox[{"(*", " ", "Populations", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"\[Beta]", "=", 
         RowBox[{"dispars", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", 
        RowBox[{"\[Gamma]", "=", 
         RowBox[{"dispars", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
        RowBox[{"(*", " ", 
         RowBox[{"Disease", " ", "parameters"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"T", "=", 
         RowBox[{"plan", " ", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
        RowBox[{"(*", " ", 
         RowBox[{"Time", " ", "horizon"}], " ", "*)"}], "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{"\[Nu]", "=", 
         RowBox[{"plan", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], ",", 
        RowBox[{"(*", " ", 
         RowBox[{"Risk", " ", "perception"}], " ", "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"cred", "=", 
         RowBox[{"disen", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Activity", " ", "reduction", " ", "of", " ", "infected", " ", 
          "ones", " ", "due", " ", "to", " ", "symptoms", " ", "severity"}], 
         " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"iutred", "=", 
         RowBox[{"disen", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}], "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Reduced", " ", "utility", " ", "obtained", " ", "while", " ", 
         "infected"}], " ", "*)"}], "\[IndentingNewLine]", "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "=", "48"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "maximum", " ", "possible", " ", "#", " ", "of", " ", "contacts"}], 
         ",", " ", 
         RowBox[{
         "the", " ", "optimal", " ", "utility", " ", "is", " ", "at", " ", 
          "half", " ", "of", " ", "this"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"maxcr", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{"b", "/", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"ci", "=", 
        RowBox[{"maxcr", " ", 
         RowBox[{"(", "cred", ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"cr", "=", "maxcr"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Delta]", "=", "0.99986"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"discount", " ", "factor"}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Vector", " ", "storaging", " ", "the", " ", "optimal", " ", "s", " ",
          "utility"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"EUS", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"The", " ", 
          RowBox[{"individual", "'"}], "s", " ", "goal", " ", "is", " ", "to",
           " ", "remain", " ", "suceptible", " ", "by", " ", "the", " ", 
          "end", " ", "of", " ", "the", " ", "planning", " ", "horizon"}], 
         ",", " ", 
         RowBox[{
          RowBox[{"so", " ", "cs"}], "=", 
          RowBox[{"maxcr", "=", "12"}]}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"EUS", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", 
        RowBox[{"fs", "[", 
         RowBox[{"b", ",", "\[Nu]", ",", "maxcr"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Vector", " ", "storaging", " ", "the", " ", "optimal", " ", "i", " ",
          "utility"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"EUI", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Vector", " ", "storaging", " ", "the", " ", "optimal", " ", "r", " ",
          "utility"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"EUR", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Vector", " ", "storaging", " ", "the", " ", "optimal", " ", 
         "contact", " ", "rate", " ", "for", " ", "susceptible", " ", 
         "individuals"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"cs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "The", " ", "last", " ", "step", " ", "is", " ", "already", " ", 
          "known"}], ",", " ", 
         RowBox[{
         "the", " ", "susceptible", " ", "indivial", " ", "wants", " ", "to", 
          " ", "be", " ", "susceptible", " ", "at", " ", "the", " ", "end", 
          " ", "of", " ", "the", " ", "time", " ", "horizon"}], ",", " ", 
         RowBox[{
         "then", " ", "it", " ", "is", " ", "assumed", " ", "that", " ", 
          "susceptible", " ", "individuals", " ", "have", " ", "an", " ", 
          "optimized", " ", "contact", " ", "rate", " ", "before", " ", "the",
           " ", "behavior", " ", "change"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cs", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", "maxcr"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Pii", "=", 
          RowBox[{"1", "-", 
           SuperscriptBox["P", "z"]}]}], ",", " ", 
         RowBox[{
         "probability", " ", "of", " ", "continuing", " ", "infectious"}], 
         ",", " ", 
         RowBox[{"independent", " ", "of", " ", "the", " ", "system"}], ",", 
         " ", 
         RowBox[{
          RowBox[{"it", "'"}], "s", " ", "outside", " ", "the", " ", 
          "loop"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Pii", "=", 
        RowBox[{"Exp", "[", 
         RowBox[{"-", "\[Gamma]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Optimization", " ", "procedure"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"t", "=", "T"}], ",", 
         RowBox[{"t", "\[GreaterEqual]", " ", "1"}], ",", 
         RowBox[{"t", "--"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"Horizon", " ", "times"}], ",", " ", 
           RowBox[{"this", " ", "goes", " ", "backwards"}]}], " ", "*)"}], 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"individual", "'"}], "s", " ", "utility", " ", "starts", 
           " ", "at", " ", 
           RowBox[{"zero", ":", " ", 
            RowBox[{"will", " ", "increase"}]}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"maxu", "=", "0"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
            "Evaluating", " ", "all", " ", "the", " ", "contact", " ", 
             "rates", " ", "for", " ", "susceptible", " ", "individuals"}], 
            ",", " ", 
            RowBox[{
            "all", " ", "possible", " ", "variable", " ", "states"}]}], " ", 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"csd", "=", "1"}], ",", 
            RowBox[{"csd", "\[LessEqual]", "maxcr"}], ",", 
            RowBox[{"csd", "++"}], ",", " ", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{
              "Probability", " ", "of", " ", "continuing", " ", 
               "susceptible"}], ",", " ", 
              RowBox[{"dependent", " ", "on", " ", "the", " ", "prevalence"}],
               ",", " ", 
              RowBox[{
               RowBox[{"that", "'"}], "s", " ", "why", " ", "it", " ", "is", 
               " ", "inside", " ", "the", " ", "loop"}]}], " ", "*)"}], 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Pss", "=", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "\[Beta]"}], 
                RowBox[{"(", 
                 FractionBox[
                  RowBox[{"csd", " ", "ci", " ", "i"}], 
                  RowBox[{
                   RowBox[{"csd", " ", "s"}], "+", 
                   RowBox[{"ci", " ", "i"}], "+", 
                   RowBox[{"maxcr", " ", "r"}]}]], ")"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "Evaluating", " ", "the", " ", "expected", " ", "utilities"}], 
              " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
              "Utility", " ", "gained", " ", "by", " ", "being", " ", 
               "currently", " ", "susceptible"}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"EUS", "[", 
               RowBox[{"[", "t", "]"}], "]"}], "=", " ", 
              RowBox[{
               RowBox[{"fs", "[", 
                RowBox[{"b", ",", "\[Nu]", ",", "csd"}], "]"}], " ", "+", 
               RowBox[{"\[Delta]", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Pss", " ", 
                   RowBox[{"EUS", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", "Pss"}], ")"}], " ", 
                   RowBox[{"EUI", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}]}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
              "Utility", " ", "gained", " ", "by", " ", "being", " ", 
               "currently", " ", "Infected"}], "*)"}], "\[IndentingNewLine]", 
             
             RowBox[{
              RowBox[{"EUI", "[", 
               RowBox[{"[", "t", "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"iutred", " ", 
                RowBox[{"fs", "[", 
                 RowBox[{"b", ",", "\[Nu]", ",", "ci"}], "]"}]}], " ", "+", 
               RowBox[{"\[Delta]", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Pii", " ", 
                   RowBox[{"EUI", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", "Pii"}], ")"}], " ", 
                   RowBox[{"EUR", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}]}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
