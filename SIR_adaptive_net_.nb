Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "500"}], ";", " ", 
  RowBox[{"ped", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"net", "=", 
   RowBox[{"RandomGraph", "[", 
    RowBox[{
     RowBox[{"BernoulliGraphDistribution", "[", 
      RowBox[{"n", ",", "ped"}], "]"}], ",", 
     RowBox[{"VertexLabels", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"epidist", " ", "=", " ", 
   RowBox[{"episim", "[", 
    RowBox[{"net", ",", " ", "40", ",", " ", "200", ",", " ", 
     RowBox[{"{", 
      RowBox[{"0.05", ",", " ", "0.04"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allplots", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"epidist", "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", ";;", ",", "2"}], "]"}], "]"}], "/", "n"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"Directive", "[", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"Opacity", "[", "0.025", "]"}]}], "}"}], "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanplot", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Mean", "@", 
       RowBox[{"epidist", "[", 
        RowBox[{"[", 
         RowBox[{";;", ",", ";;", ",", "2"}], "]"}], "]"}]}], "/", "n"}], ",", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Red", ",", "Thick"}], "}"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"plotnob", "=", 
  RowBox[{"Show", "[", 
   RowBox[{"allplots", ",", "meanplot"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.909164183450533*^9, 3.909164220372141*^9}},
 CellLabel->
  "In[313]:=",ExpressionUUID->"673c41f2-a94c-413c-b798-525956571e04"],

