Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "500"}], ";", " ", 
  RowBox[{"ped", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"net", "=", 
   RowBox[{"RandomGraph", "[", 
    RowBox[{
     RowBox[{"BernoulliGraphDistribution", "[", 
      RowBox[{"n", ",", "ped"}], "]"}], ",", 
     RowBox[{"VertexLabels", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vvector", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"0.05", ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Tvector", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"7", ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bepidist", " ", "=", " ", 
   RowBox[{"bepisim", "[", 
    RowBox[{"net", ",", " ", "20", ",", "100", ",", 
     RowBox[{"{", 
      RowBox[{"0.05", ",", "0.04"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"vvector", ",", "Tvector"}], "}"}], ",", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "pconsti", ",", "pbehav", ",", " ", "popredplot", " ", ",", " ", 
     "susredplot"}], "}"}], " ", "=", " ", 
   RowBox[{"getplots", "[", 
    RowBox[{"net", ",", " ", "epidist", ",", " ", "bepidist"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"pconsti", ",", "pbehav"}], "]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"susredplot", ",", "popredplot"}], "]"}]}], "Input",
 CellChangeTimes->{
  3.909164237440479*^9, {3.910258184961315*^9, 
   3.910258187022688*^9}},ExpressionUUID->"d99df054-e210-4ea8-a9b2-\
b91bf818f9fd"],

