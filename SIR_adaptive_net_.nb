Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"bepisim", "[", 
    RowBox[{
    "ntwk_", ",", " ", "epidemics_", ",", "iterations_", ",", "dispars_", ",",
      "u_", ",", "neis_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"net", " ", "=", " ", "ntwk"}], ",", "\[IndentingNewLine]", 
       RowBox[{"bepis", " ", "=", " ", "epidemics"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"it", " ", "=", " ", "iterations"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"pi", "=", 
        RowBox[{"dispars", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"pr", "=", 
        RowBox[{"dispars", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
       RowBox[{"(*", 
        RowBox[{"disease", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"v", " ", "=", " ", 
        RowBox[{"u", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"T", "=", 
        RowBox[{"u", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"time", " ", "horizon"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ns", "=", "neis"}]}], " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Neighboorhood", " ", "size", " ", "to", " ", "get", " ", "the", " ", 
        "local", " ", "prevalence"}], "*)"}], "\[IndentingNewLine]", "}"}], 
     ",", "\n", "\n", 
     RowBox[{
      RowBox[{"bepidist", "=", 
       RowBox[{
       "ParallelTable", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Declare", " ", "infected"}], ",", " ", 
          RowBox[{
          "susceptible", " ", "and", " ", "recovered", " ", "vectors"}]}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Clear", "[", 
           RowBox[{"i", ",", "s"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"i0", "=", 
           RowBox[{"RandomInteger", "[", "n", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"i", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"k", "\[Equal]", "i0"}], ",", "1", ",", "0"}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{"1", ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "-", 
            "i"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"r", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"rednet", "=", "net"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"epib", "=", 
           RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
             "#", " ", "of", " ", "infected", " ", "neighboors", " ", "per", 
              " ", "node"}], " ", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"infn", "=", 
               RowBox[{
                RowBox[{"AdjacencyMatrix", "[", "rednet", "]"}], ".", "i"}]}],
               ";", " ", "\[IndentingNewLine]", 
              RowBox[{"ninfp", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"1", "-", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"1", "-", "pi"}], ")"}], "#"]}], "&"}], "/@", 
                "infn"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Newly", " ", "infected", " ", "nodes"}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"x", "=", 
               RowBox[{"RandomReal", "[", 
                RowBox[{"1", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"newinf", "=", 
               RowBox[{"Boole", "[", 
                RowBox[{"Thread", "[", 
                 RowBox[{"x", "\[LessEqual]", "ninfp"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"upi", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"s", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}], "&&", 
                    RowBox[{
                    RowBox[{"newinf", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}]}], ",", 
                   "1", ",", "0"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Update", " ", "S", " ", "and", " ", "I", " ", 
                RowBox[{"vectors", ":", " ", 
                 RowBox[{"after", " ", "infections"}]}]}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"inew", "=", 
               RowBox[{"i", "+", "upi"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"snew", "=", 
               RowBox[{"s", "-", "upi"}]}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"y", "=", 
               RowBox[{"RandomReal", "[", 
                RowBox[{"1", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"newrec", "=", 
               RowBox[{"Boole", "[", 
                RowBox[{"Thread", "[", 
                 RowBox[{"y", "\[LessEqual]", "pr"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Update", " ", "I", " ", "and", " ", "R", " ", 
                RowBox[{"vectors", ":", " ", 
                 RowBox[{"after", " ", "recovery"}]}]}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"upr", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"inew", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}], "&&", 
                    RowBox[{
                    RowBox[{"newrec", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}]}], ",", 
                   "1", ",", "0"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"rnew", "=", 
               RowBox[{"r", "+", "upr"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"inew", "=", 
               RowBox[{"inew", "-", "upr"}]}], ";", "\[IndentingNewLine]", 
              " ", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Update", " ", "variable", " ", "vectors"}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"s", "=", "snew"}], ";", " ", 
              RowBox[{"i", "=", "inew"}], ";", 
              RowBox[{"r", "=", "rnew"}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{"=", 
                RowBox[{
                 RowBox[{"-=", 
                  RowBox[{"-=", " ", 
                   RowBox[{"The", " ", "maximization", " ", "process"}]}]}], 
                 " ", "=", 
                 RowBox[{"-=", "-="}]}]}], " ", "*)"}], "\[IndentingNewLine]",
               "\[IndentingNewLine]", 
              RowBox[{"rednet", "=", "net"}], ";", " ", 
              RowBox[{"(*", 
               RowBox[{"Define", " ", "a", " ", "dummy", " ", 
                RowBox[{"network", ":", " ", 
                 RowBox[{
                 "this", " ", "is", " ", "the", " ", "network", " ", "to", 
                  " ", "play", " ", "with"}]}]}], "*)"}], 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Get", " ", "the", " ", "info", " ", "of", " ", "all", " ", 
                "susceptible", " ", "nodes", " ", "at", " ", "time", " ", 
                "t"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"sus", "=", 
               RowBox[{"Flatten", "@", 
                RowBox[{"Position", "[", 
                 RowBox[{"s", ",", "1"}], "]"}]}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"infofsus", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"infneighs", "[", 
                  RowBox[{"net", ",", "#", ",", "ns", ",", "i"}], "]"}], 
                 "&"}], "/@", "sus"}]}], ";", "\n", "\n", "\t\t", 
              RowBox[{"vuse", " ", "=", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"v", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], "/@", " ", 
                "sus"}]}], ";", "\n", "\t\t", 
              RowBox[{"Tuse", " ", "=", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"T", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], " ", "&"}], "/@", " ", 
                "sus"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Get", " ", "only", " ", "the", " ", "info", " ", "of", " ", 
                "susceptible", " ", "with", "  ", "infected", " ", 
                "neighbours"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"susinfs", "=", 
               RowBox[{
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"infofsus", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "2"}], "]"}], "]"}], "\[NotEqual]", 
                    "0"}], ",", 
                    RowBox[{"infofsus", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"k", ",", "1", ",", 
                    RowBox[{"Length", "@", "sus"}]}], "}"}]}], "]"}], "/.", 
                RowBox[{"Null", "\[Rule]", 
                 RowBox[{"Sequence", "[", "]"}]}]}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", " ", 
               RowBox[{
               "Use", " ", "the", " ", "maximizer", " ", "to", " ", "define", 
                " ", "how", " ", "many", " ", "edges", " ", "to", " ", 
                RowBox[{"drop", ":", " ", 
                 RowBox[{
                 "it", " ", "returns", " ", "the", " ", "number", " ", "of", 
                  " ", "edges", " ", "to", " ", "leave"}]}]}], " ", "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"redneighs", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"vertxmaxer", "[", 
                   RowBox[{"net", ",", 
                    RowBox[{"susinfs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"pi", ",", "pr"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"vuse", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", 
                    RowBox[{"Tuse", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", "ns"}], 
                   "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", "1", ",", 
                   RowBox[{"Length", "[", "susinfs", "]"}]}], "}"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Get", " ", "the", " ", "list", " ", "of", " ", "the", " ", 
                "form", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"susceptible", "  ", "id"}], ",", 
                  RowBox[{"{", 
                   RowBox[{
                   "list", " ", "of", " ", "infected", " ", "neighbours", " ",
                     "to", " ", "remove"}], "}"}]}], "}"}]}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"list", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"susinfs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", 
                   RowBox[{"RandomSample", "[", 
                    RowBox[{
                    RowBox[{"susinfs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "3"}], "]"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"susinfs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "2"}], "]"}], "]"}], "-", 
                    RowBox[{"redneighs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}]}], "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", "1", ",", 
                   RowBox[{"Length", "[", "redneighs", "]"}]}], "}"}]}], 
                "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Create", " ", "the", " ", "list", " ", "of", " ", "all", " ", 
                "the", " ", "edges", " ", "to", " ", "remove", " ", "at", " ",
                 "time", " ", 
                RowBox[{"t", ":", " ", 
                 RowBox[{"of", " ", "the", " ", "form", " ", 
                  RowBox[{"{", 
                   RowBox[{"s", ",", 
                    RowBox[{"i", "-", "rem"}]}], "}"}]}]}]}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"edgestorem", "=", 
               RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
                RowBox[{"Table", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"list", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "1"}], "]"}], "]"}], 
                    "\[UndirectedEdge]", "#"}], "}"}], "&"}], "/@", 
                   RowBox[{"list", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "2"}], "]"}], "]"}]}], 
                  "\[IndentingNewLine]", ",", 
                  RowBox[{"{", 
                   RowBox[{"k", ",", "1", ",", 
                    RowBox[{"Length", "@", "redneighs"}]}], "}"}]}], "]"}], 
                "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
               "Drop", " ", "edges", " ", "from", " ", "the", " ", 
                "network"}], "*)"}], "\[IndentingNewLine]", 
              RowBox[{"rednet", "=", 
               RowBox[{"EdgeDelete", "[", 
                RowBox[{"rednet", ",", "edgestorem"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Count", "[", 
                 RowBox[{"s", ",", "1"}], "]"}], ",", 
                RowBox[{"Count", "[", 
                 RowBox[{"i", ",", "1"}], "]"}], ",", 
                RowBox[{"Count", "[", 
                 RowBox[{"r", ",", "1"}], "]"}], ",", 
                RowBox[{"EdgeCount", "[", "rednet", "]"}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"N", "@", 
                 RowBox[{"Mean", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"IncidenceList", "[", 
                    RowBox[{"rednet", ",", "#"}], "]"}], "]"}], "&"}], "/@", 
                   "sus"}], "]"}]}]}], "}"}]}], "\[IndentingNewLine]", 
             "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"l", ",", "2", ",", "it"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", "epib"}], 
         "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", "1", ",", "bepis"}], "}"}]}], "]"}]}], ";", "\n", 
      "\n", 
      RowBox[{"Return", "[", "bepidist", "]"}], ";"}]}], "\n", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9102581308272257`*^9, 3.910258141300254*^9}},
 CellLabel->
  "In[311]:=",ExpressionUUID->"1e5006c6-afcc-4fec-85c4-b07cb60ef9b0"],

