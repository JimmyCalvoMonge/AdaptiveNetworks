              RowBox[{"newrec", "=", 
               RowBox[{"Boole", "[", 
                RowBox[{"Thread", "[", 
                 RowBox[{"y", "\[LessEqual]", "pr"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Update", " ", "I", " ", "and", " ", "R", " ", 
                RowBox[{"vectors", ":", " ", 
                 RowBox[{"after", " ", "recovery"}]}]}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"upr", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"inew", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}], "&&", 
                    RowBox[{
                    RowBox[{"newrec", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}]}], ",", 
                   "1", ",", "0"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"rnew", "=", 
               RowBox[{"r", "+", "upr"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"inew", "=", 
               RowBox[{"inew", "-", "upr"}]}], ";", "\[IndentingNewLine]", 
              " ", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Update", " ", "variable", " ", "vectors"}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"s", "=", "snew"}], ";", " ", 
              RowBox[{"i", "=", "inew"}], ";", 
              RowBox[{"r", "=", "rnew"}], ";", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Count", "[", 
                 RowBox[{"snew", ",", "1"}], "]"}], ",", 
                RowBox[{"Count", "[", 
                 RowBox[{"inew", ",", "1"}], "]"}], ",", 
                RowBox[{"Count", "[", 
                 RowBox[{"rnew", ",", "1"}], "]"}]}], "}"}]}], 
             "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"l", ",", "2", ",", "it"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", "epi"}], 
         "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", "epis"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\n", 
      RowBox[{"Return", "[", "epidist", "]"}], ";"}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]], "Input",
