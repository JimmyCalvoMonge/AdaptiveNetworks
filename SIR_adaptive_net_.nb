Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"episim", "[", 
    RowBox[{
    "ntwk_", ",", "epidemics_", ",", " ", "iterations_", ",", " ", 
     "dispars_"}], "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"net", " ", "=", " ", "ntwk"}], ",", "\[IndentingNewLine]", 
       RowBox[{"epis", " ", "=", " ", "epidemics"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"it", " ", "=", " ", "iterations"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"pi", "=", 
        RowBox[{"dispars", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"pr", "=", 
        RowBox[{"dispars", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ","}], " ", 
      RowBox[{"(*", 
       RowBox[{"disease", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
      "}"}], ",", "\n", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"epidist", "=", 
       RowBox[{
       "ParallelTable", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Declare", " ", "infected"}], ",", " ", 
          RowBox[{
          "susceptible", " ", "and", " ", "recovered", " ", "vectors"}]}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"Clear", "[", 
           RowBox[{"i", ",", "s"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"i0", "=", 
           RowBox[{"RandomInteger", "[", "n", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"i", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"k", "\[Equal]", "i0"}], ",", "1", ",", "0"}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{"1", ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "-", 
            "i"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"r", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"epi", "=", 
           RowBox[{"Table", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", " ", 
             RowBox[{
             "#", " ", "of", " ", "infected", " ", "neighboors", " ", "per", 
              " ", "node"}], " ", "*)"}], "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"infn", "=", 
               RowBox[{
                RowBox[{"AdjacencyMatrix", "[", "net", "]"}], ".", "i"}]}], 
              ";", " ", "\[IndentingNewLine]", 
              RowBox[{"ninfp", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"1", "-", 
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"1", "-", "pi"}], ")"}], "#"]}], "&"}], "/@", 
                "infn"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Newly", " ", "infected", " ", "nodes"}], "*)"}], 
              "\[IndentingNewLine]", 
              RowBox[{"x", "=", 
               RowBox[{"RandomReal", "[", 
                RowBox[{"1", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"newinf", "=", 
               RowBox[{"Boole", "[", 
                RowBox[{"Thread", "[", 
                 RowBox[{"x", "\[LessEqual]", "ninfp"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"upi", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"s", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}], "&&", 
                    RowBox[{
                    RowBox[{"newinf", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "\[Equal]", "1"}]}], ",", 
                   "1", ",", "0"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", "\[IndentingNewLine]", 
