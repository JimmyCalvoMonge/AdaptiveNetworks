    RowBox[{
     RowBox[{"Floor", "[", "#", "]"}], " ", "&"}], "/@", 
    RowBox[{"RandomVariate", "[", 
     RowBox[{"distT", ",", " ", "n"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"Show", "[", "\n", " ", 
