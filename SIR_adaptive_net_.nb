Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "500"}], ";", " ", 
  RowBox[{"ped", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"net", "=", 
   RowBox[{"RandomGraph", "[", 
    RowBox[{
     RowBox[{"BernoulliGraphDistribution", "[", 
      RowBox[{"n", ",", "ped"}], "]"}], ",", 
     RowBox[{"VertexLabels", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vvector", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{"0.05", ",", " ", 
     RowBox[{"{", 
      RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Tvector", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{"7", ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Increase", " ", "planning", " ", "horizon"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"bepidist", " ", "=", " ", 
   RowBox[{"bepisim", "[", 
    RowBox[{"net", ",", " ", "2", ",", "200", ",", 
     RowBox[{"{", 
      RowBox[{"0.05", ",", "0.04"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"vvector", ",", "Tvector"}], "}"}], ",", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "pconsti", ",", "pbehav", ",", " ", "popredplot", " ", ",", " ", 
     "susredplot"}], "}"}], " ", "=", " ", 
   RowBox[{"getplots", "[", 
    RowBox[{"net", ",", " ", "epidist", ",", " ", "bepidist"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"pconsti", ",", "pbehav"}], "]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"susredplot", ",", "popredplot"}], "]"}]}], "Input",
 CellLabel->
  "In[90]:= ",ExpressionUUID->"aa35a416-8450-4d5b-9c67-74a548503254"],

