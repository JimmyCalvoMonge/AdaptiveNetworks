Cell[BoxData[{
 RowBox[{
  RowBox[{"n", "=", "500"}], ";", " ", 
  RowBox[{"ped", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"net", "=", 
   RowBox[{"RandomGraph", "[", 
    RowBox[{
     RowBox[{"BernoulliGraphDistribution", "[", 
      RowBox[{"n", ",", "ped"}], "]"}], ",", 
     RowBox[{"VertexLabels", "\[Rule]", "\"\<\>\""}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bepidist2", " ", "=", " ", 
   RowBox[{"bepisim", "[", 
    RowBox[{"net", ",", " ", "4", ",", "100", ",", 
     RowBox[{"{", 
      RowBox[{"0.05", ",", "0.04"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"VDist", ",", "TDist"}], "}"}], ",", "1"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "pconsti2", ",", "pbehav2", ",", " ", "popredplot2", " ", ",", " ", 
     "susredplot2"}], "}"}], " ", "=", " ", 
   RowBox[{"getplots", "[", 
