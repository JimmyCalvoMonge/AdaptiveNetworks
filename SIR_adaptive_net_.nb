Cell[BoxData[{
 RowBox[{
  RowBox[{"distT", " ", "=", " ", 
   RowBox[{"MixtureDistribution", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"7", ",", " ", "0.5"}], "]"}], ",", 
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"16", ",", " ", "1"}], "]"}]}], " ", "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"TDist", " ", "=", " ", 
