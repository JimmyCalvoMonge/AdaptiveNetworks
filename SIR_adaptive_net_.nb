Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Other", " ", 
    RowBox[{"plots", ":", " ", 
     RowBox[{
     "Individual", " ", "adaptive", " ", "response", " ", "and", " ", 
      "susceptible", " ", "nodes"}]}]}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"pbehavsus", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Mean", "@", "btseriessus"}], "+", 
          RowBox[{"StandardDeviation", "[", 
           RowBox[{"N", "@", "btseriessus"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"Mean", "@", "btseriessus"}], "-", 
          RowBox[{"StandardDeviation", "[", 
           RowBox[{"N", "@", "btseriessus"}], "]"}]}], ",", 
         RowBox[{"Mean", "@", "btseriessus"}]}], "}"}], ",", 
       RowBox[{"Filling", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"3", "\[Rule]", 
            RowBox[{"{", "2", "}"}]}], "}"}], ",", 
          RowBox[{"3", "\[Rule]", 
