Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"getplots", "[", 
    RowBox[{
    "ntwk_", ",", " ", "epidistribution_", ",", " ", "bepidistribution_"}], 
    "]"}], ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"net", " ", "=", " ", "ntwk"}], ",", "\n", 
       RowBox[{"epidist", " ", "=", " ", "epidistribution"}], ",", "\n", 
       RowBox[{"bepidist", " ", "=", " ", "bepidistribution"}]}], 
      "\[IndentingNewLine]", "}"}], ",", "\n", "\n", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Infected", " ", "population", " ", "dynamics"}], " ", "-", 
       " ", 
       RowBox[{"classic", " ", "model"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tseries", "=", 
       RowBox[{
        RowBox[{"epidist", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "2"}], "]"}], "]"}], "/", "n"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Infected", " ", "population", " ", "dynamics"}], " ", "-", 
        " ", 
        RowBox[{"classic", " ", "model"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"tseriesrec", "=", 
       RowBox[{
        RowBox[{"epidist", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "3"}], "]"}], "]"}], "/", "n"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Total", " ", "number", " ", "of", " ", "edges", " ", "in", " ", "the",
         " ", "network"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"edglist", "=", 
       RowBox[{
        RowBox[{"bepidist", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "4"}], "]"}], "]"}], "/", 
        RowBox[{"EdgeCount", "[", "net", "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Infected", " ", "population", " ", "dynamics"}], " ", "-", 
        " ", 
        RowBox[{"adaptive", " ", "model"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"btseriesinf", "=", 
       RowBox[{
        RowBox[{"bepidist", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "2"}], "]"}], "]"}], "/", "n"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Susceptible", " ", "population", " ", "dynamics"}], " ", "-",
         " ", 
        RowBox[{"adaptive", " ", "model"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"btseriessus", "=", 
       RowBox[{
        RowBox[{"bepidist", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "1"}], "]"}], "]"}], "/", "n"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Recovered", " ", "population", " ", "dynamics"}], " ", "-", 
        " ", 
        RowBox[{"adaptive", " ", "model"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"btseriesrec", "=", 
       RowBox[{
        RowBox[{"bepidist", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "3"}], "]"}], "]"}], "/", "n"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Susceptible", " ", 
        RowBox[{"inds", ".", " ", "mean"}], " ", "number", " ", "of", " ", 
        "edges"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"susedglist", "=", 
       RowBox[{
        RowBox[{"bepidist", "[", 
         RowBox[{"[", 
          RowBox[{";;", ",", ";;", ",", "5"}], "]"}], "]"}], "/", 
        RowBox[{"N", "@", 
         RowBox[{"Mean", "@", 
          RowBox[{"VertexDegree", "[", "net", "]"}]}]}]}]}], ";", "\n", "\n", 
      RowBox[{"(*", 
       RowBox[{"Static", " ", "network", " ", "disease", " ", "dynamics"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"pconsti", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Mean", "@", "tseries"}], ",", 
           RowBox[{
            RowBox[{"Mean", "@", "tseries"}], "+", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"N", "@", "tseries"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"Mean", "@", "tseries"}], "-", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"N", "@", "tseries"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Filling", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", "\[Rule]", 
              RowBox[{"{", "3", "}"}]}], "}"}], ",", 
            RowBox[{"1", "\[Rule]", 
             RowBox[{"{", "2", "}"}]}]}], "}"}]}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{"Thick", ",", "Dashed"}], "]"}], ",", "None", ",", 
            "None"}], "}"}]}], ",", 
         RowBox[{"TicksStyle", "\[Rule]", 
          RowBox[{"Directive", "[", 
           RowBox[{"Bold", ",", " ", "14"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Adaptive", " ", "network", " ", "disease", " ", "dynamics"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"pbehav", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"Mean", "@", "btseriesinf"}], "+", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"N", "@", "btseriesinf"}], "]"}]}], ",", 
           RowBox[{"Mean", "@", "btseriesinf"}], ",", 
           RowBox[{
            RowBox[{"Mean", "@", "btseriesinf"}], "-", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"N", "@", "btseriesinf"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Filling", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", "\[Rule]", 
              RowBox[{"{", "3", "}"}]}], "}"}], ",", 
            RowBox[{"2", "\[Rule]", 
             RowBox[{"{", "1", "}"}]}]}], "}"}]}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{"None", ",", 
            RowBox[{"Directive", "[", 
             RowBox[{"Thick", ",", "Red"}], "]"}], ",", "None"}], "}"}]}], 
         ",", 
         RowBox[{"TicksStyle", "\[Rule]", 
          RowBox[{"Directive", "[", 
           RowBox[{"Bold", ",", " ", "14"}], "]"}]}]}], "]"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Total", " ", "population", " ", "activity", " ", "dynamics"}],
        "*)"}], "\n", 
      RowBox[{"Miny", " ", "=", " ", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"Mean", "@", "susedglist"}], "-", 
         RowBox[{"2", "*", 
          RowBox[{"StandardDeviation", "[", 
           RowBox[{"N", "@", "susedglist"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"popredplot", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Mean", "@", "edglist"}], ",", 
           RowBox[{
            RowBox[{"Mean", "@", "edglist"}], "+", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"N", "@", "edglist"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"Mean", "@", "edglist"}], "-", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"N", "@", "edglist"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Filling", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", "\[Rule]", 
              RowBox[{"{", "3", "}"}]}], "}"}], ",", 
            RowBox[{"1", "\[Rule]", 
             RowBox[{"{", "2", "}"}]}]}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{"Thick", ",", "Black"}], "]"}], ",", "None", ",", 
            "None"}], "}"}]}], ",", 
         RowBox[{"TicksStyle", "\[Rule]", 
          RowBox[{"Directive", "[", 
           RowBox[{"Bold", ",", " ", "14"}], "]"}]}], ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "100"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Miny", ",", " ", "1"}], "}"}]}], "}"}]}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Avg", ".", "node"}], " ", "specific", " ", "activity", " ", 
        "dynamics"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"susredplot", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Mean", "@", "susedglist"}], ",", 
           RowBox[{
            RowBox[{"Mean", "@", "susedglist"}], "+", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"N", "@", "susedglist"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"Mean", "@", "susedglist"}], "-", 
            RowBox[{"StandardDeviation", "[", 
             RowBox[{"N", "@", "susedglist"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Filling", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", "\[Rule]", 
              RowBox[{"{", "3", "}"}]}], "}"}], ",", 
            RowBox[{"1", "\[Rule]", 
             RowBox[{"{", "2", "}"}]}]}], "}"}]}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Directive", "[", 
             RowBox[{"Thick", ",", "Dashed", ",", "Blue"}], "]"}], ",", 
            "None", ",", "None"}], "}"}]}], ",", 
         RowBox[{"TicksStyle", "\[Rule]", 
          RowBox[{"Directive", "[", 
           RowBox[{"Bold", ",", " ", "14"}], "]"}]}], ",", 
         RowBox[{"PlotRange", "\[Rule]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "50"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Miny", ",", " ", "1"}], "}"}]}], "}"}]}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", "\n", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{
        "pconsti", ",", "pbehav", ",", " ", "popredplot", " ", ",", " ", 
         "susredplot"}], "}"}], "]"}]}]}], "\n", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[312]:=",ExpressionUUID->"0fe3f0fd-4e5e-46aa-a711-d147d86c686b"]
}, Open  ]],

